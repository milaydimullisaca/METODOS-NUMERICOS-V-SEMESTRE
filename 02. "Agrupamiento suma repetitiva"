#include <iostream>
using namespace std;

int main() {
    float suma = 1.0;
    float grupo = 0.0;

    for (int i = 0; i < 10000; i++) {
        grupo = grupo + 0.00001f;

        if ((i + 1) % 100 == 0) {
            suma = suma + grupo;
            grupo = 0.0;
        }
    }

    cout << "Resultado: " << suma << endl;

    return 0;
} 
