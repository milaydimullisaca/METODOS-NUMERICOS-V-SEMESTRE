#include <iostream>
using namespace std;

int main() {
    double suma = 1.0;
    double grupo = 0.0;

    for (int i = 1; i <= 10000; i++) {
        grupo = grupo + 0.00001;

        if (i % 100 == 0) {
            suma = suma + grupo;
            grupo = 0.0;
        }
    }

    cout << "Resultado: " << suma << endl;

    return 0;
}
