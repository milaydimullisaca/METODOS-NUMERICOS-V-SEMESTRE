#include <iostream>
using namespace std;

int main() {
    int suma = 100000;
    int grupo = 0;

    for (int i = 1; i <= 10000; i++) {
        grupo = grupo + 1;

        if (i % 100 == 0) {
            suma = suma + grupo;
            grupo = 0;
        }
    }

    cout << "Resultado: " << suma / 100000
         << "." << suma % 100000 << endl;

    return 0;
}
