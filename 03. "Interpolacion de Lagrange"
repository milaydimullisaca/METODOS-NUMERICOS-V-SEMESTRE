#include<iostream>
#include<string>
#include<sstream>
using namespace std;


string num(float v){
    ostringstream o;
    o << v;
    return o.str();
}

// Arma un factor: (a - b) o (a + |b|) si b es negativo
string fac(string a, float b){
    if(b < 0) return "(" + a + " + " + num(-b) + ")";
    return "(" + a + " - " + num(b) + ")";
}

// Centra un texto dentro de un ancho w
string centrar(string s, int w){
    int izq = (w - (int)s.size()) / 2;
    int der = w - (int)s.size() - izq;
    return string(izq, ' ') + s + string(der, ' ');
}

// Muestra la formula de Lagrange con 'var' (T o el valor de X)
void mostrarFormula(int n, float datos_x[], float datos_f[], string var){
    string primero = "g(" + var + ") = ";
    string otro    = string(primero.size() - 2, ' ') + "+ ";
    string blanco  = string(primero.size(), ' ');

    for(int i = 0; i < n; i++){
        string nu = "", de = "";
        for(int j = 0; j < n; j++){
            if(j != i){
                nu += fac(var, datos_x[j]);
                de += fac(num(datos_x[i]), datos_x[j]);
            }
        }
        if(nu == ""){ nu = "1"; de = "1"; }

        int w = (int)nu.size();
        if((int)de.size() > w) w = (int)de.size();

        cout << blanco << centrar(nu, w) << endl;
        cout << (i == 0 ? primero : otro) << string(w, '-') << " (" << num(datos_f[i]) << ")" << endl;
        cout << blanco << centrar(de, w) << endl << endl;
    }
}

int main(){

    int n;
    float x, res = 0;

    cout << "Ingrese la cantidad de Datos 'i': ";
    cin >> n;

    float datos_x[n];
    float datos_f[n];
    float L_i[n];

    // Ingreso de datos
    for(int i = 0; i < n; i++){
        cout << "Posicion " << i << " :" << endl;
        cout << "Datos en X: ";
        cin >> datos_x[i];
        cout << "Datos en f(x): ";
        cin >> datos_f[i];
        cout << endl;
    }

    cout << "Ingrese el valor de X para g(x): ";
    cin >> x;

    // Calculo de Lagrange
    for(int i = 0; i < n; i++){
        float L = 1;
        for(int j = 0; j < n; j++){
            if(j != i){
                L = L * (x - datos_x[j]) / (datos_x[i] - datos_x[j]);
            }
        }
        L_i[i] = L;
        res = res + datos_f[i] * L;
    }

    // ---------------- TABLA Y RESULTADO ----------------
    cout << "\n------------------------------------------------------" << endl;
    cout << "i\tDato X\tDato f(x)\tpara X = " << x << endl;
    cout << "------------------------------------------------------" << endl;
    for(int i = 0; i < n; i++){
        cout << i << "\t" << datos_x[i] << "\t" << datos_f[i] << endl;
    }
    cout << "------------------------------------------------------" << endl;
    // ---------------- SOLUCION PASO A PASO ----------------
    cout << "\n======================================================" << endl;
    cout << "                SOLUCION PASO A PASO" << endl;
    cout << "======================================================" << endl;

    cout << "\nPaso 1: Formula con T (variable)\n" << endl;
    mostrarFormula(n, datos_x, datos_f, "X");

    cout << "Paso 2: Reemplazamos T = " << x << "\n" << endl;
    mostrarFormula(n, datos_x, datos_f, num(x));

    cout << "Paso 3: Calculamos cada termino\n" << endl;
    for(int i = 0; i < n; i++){
        cout << "  L" << i << "(" << x << ") = " << L_i[i] << endl;
        cout << "  L" << i << " * f(x" << i << ") = " << L_i[i] << " * " << datos_f[i]
             << " = " << L_i[i] * datos_f[i] << endl << endl;
    }

    cout << "Paso 4: Sumamos los terminos\n" << endl;
    cout << "  g(" << x << ") = ";
    for(int i = 0; i < n; i++){
        cout << L_i[i] * datos_f[i];
        if(i < n - 1) cout << " + ";
    }
    cout << " = " << res << endl;


    cout << "\nLa Respuesta en g(" << x << ") es: " << res << endl;

    return 0;
}
