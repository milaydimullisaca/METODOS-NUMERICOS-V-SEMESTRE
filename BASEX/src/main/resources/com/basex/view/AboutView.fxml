<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.basex.controller.AboutController"
      alignment="CENTER"
      spacing="15"
      prefWidth="420"
      prefHeight="500"
      styleClass="about-container">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <ImageView fitWidth="150"
               fitHeight="150"
               preserveRatio="true">

        <image>
            <Image url="@images/logo.png"/>
        </image>

    </ImageView>

    <Label text="BASEX"
           styleClass="about-title"/>

    <Label text="Conversor de Bases Numéricas"
           styleClass="about-subtitle"/>

    <Label text="Aplicación desarrollada para realizar conversiones entre diferentes sistemas de numeración."
           wrapText="true"
           maxWidth="340"
           alignment="CENTER"
           styleClass="about-description"/>

    <Label fx:id="versionLabel"
           styleClass="about-version"/>

    <Label text="Bases soportadas: 2 a 36"
           styleClass="about-info"/>

    <Label text="Ingeniería de Sistemas"
           styleClass="about-info"/>

    <Button text="Cerrar"
            onAction="#cerrar"
            prefWidth="120"
            styleClass="about-button"/>

</VBox>